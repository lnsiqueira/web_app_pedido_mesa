{
  "hosting": {
    "site": "deola-pedido-mesa",
    "public": "build/web",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "/",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "**/@(index.html|flutter_bootstrap.js|flutter.js|flutter_service_worker.js|versao.json|version.json|manifest.json)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "**/main.*.dart.js",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      }
    ]
  },
  "flutter": {
    "platforms": {
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "foodautomation-1a2f8",
          "configurations": { "web": "1:441133021852:web:0b5f00905c1a824783cb59" }
        }
      }
    }
  }
}
